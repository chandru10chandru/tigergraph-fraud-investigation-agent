CREATE QUERY detect_structuring(VERTEX<User> input_user, DOUBLE max_single_amount = 10000.0, DOUBLE min_single_amount = 5000.0) FOR GRAPH FraudInvestigation {
    SumAccum<DOUBLE> @total_amount = 0;
    ListAccum<STRING> @tx_list;

    Start = {input_user};
    
    TxSet = SELECT t FROM Start:s -(PERFORMED_TRANSACTION:e)-> Transaction:t
            WHERE t.amount < max_single_amount AND t.amount >= min_single_amount
            ACCUM s.@total_amount += t.amount,
                  s.@tx_list += t.id;
                  
    PRINT Start[Start.id, Start.name, Start.@total_amount, Start.@tx_list];
}
